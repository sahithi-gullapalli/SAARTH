# ---- LLM: offline | openai | azure | bedrock ----
SAARTH_LLM_PROVIDER=offline
OPENAI_API_KEY=
SAARTH_OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
SAARTH_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

AWS_REGION=us-east-1
SAARTH_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= (or use an IAM role)

# ---- Embeddings: hashing | sentence-transformers | openai ----
SAARTH_EMBEDDING_PROVIDER=hashing
SAARTH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store: memory | faiss | chroma | pgvector ----
SAARTH_VECTOR_BACKEND=memory
DATABASE_URL=postgresql://saarth:saarth@localhost:5432/saarth

# ---- Retrieval / agents ----
SAARTH_TOP_K=4
SAARTH_GROUNDING_THRESHOLD=0.55
SAARTH_MAX_REVISIONS=2

# ---- Monitoring ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=saarth
